@page "/structures"

@using ProbentApps.Services.Data.Abstractions.Querying

@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject IRepository<ApplicationUser> UserRepository
@inject IRepository<StructureType> StructureTypeRepository
@inject IStructureManager StructureManager

@inherits AuthenticatedPage

<PageTitle Title=@SharedLocalizer["Structures"] />

@* Treeview des structures *@
<StructureTree Items="_items" @bind-SelectedStructure=_selectedStructure
    ManagerFinder="SearchManager" StructureTypeFinder="SearchStructureType"
    DataLoader="LoadServerData" OnSave="SaveStructure" />

@* Tableau des structures
<StructuresTable StructuresLoader="TableDataLoader" FilterManagers="FilterManagersLoader" />  *@

@code {
    private IReadOnlyCollection<TreeItemData<Structure>> _items = default!;
    private Structure? _selectedStructure;

    public async Task<IReadOnlyCollection<TreeItemData<Structure>>> LoadServerData(Structure? parentValue)
    {
        return (IReadOnlyCollection<TreeItemData<Structure>>) await StructureManager.Query<TreeItemData<Structure>>(new QueryParameters<Structure, TreeItemData<Structure>>(
            Filter: q => q.Where(parentValue?.Code is string code
                ? s => s.Code.StartsWith(code + "|") && !(s.Code.Substring(code.Length + 1).Contains("|"))
                : s => !q.Any(structure => s.Code.StartsWith(structure.Code + '|'))),
            Select: (q, r) =>
            {
                var structures = r.GetEntitySet<Structure>();
                return q.Select(s => new TreeItemData<Structure>
                {
                    Value = new Structure
                    {
                        Id = s.Id,
                        Name = s.Name,
                        Code = s.Code,
                        Manager = s.Manager == null ? null : new ApplicationUser
                        {
                            Id = s.Manager.Id,
                            UserName = s.Manager.UserName,
                            Email = s.Manager.Email
                        },
                        StructureType = new StructureType
                        {
                            Id = s.StructureType.Id,
                            Name = s.StructureType.Name,
                            SvgIconCode = s.StructureType.SvgIconCode
                        }
                    },
                    Expandable = structures.Any(structure => structure.Code.StartsWith(s.Code + "|"))
                });
            },
            SortAndPaginate: q => q,
            User: User,
            ToList: true
        ));
    }

    private static IQueryable<Structure> SelectStructureListData(IQueryable<Structure> query) => query
        .Select(static s => new Structure
        {
            Id = s.Id,
            Name = s.Name,
            Code = s.Code,
            ShortCode = s.ShortCode,
            Manager = s.Manager == null ? null : new ApplicationUser
            {
                Id = s.Manager.Id,
                UserName = s.Manager.UserName,
                Email = s.Manager.Email
            },
            StructureType = s.StructureType
        });

    private IQueryable<ApplicationUser> SelectFilterManagers(IQueryable<Structure> query) => query
        .Where(static s => s.Manager != null)
        .Select(static s => new ApplicationUser
        {
            Id = s.Manager!.Id,
            UserName = s.Manager.UserName,
            Email = s.Manager.Email
        });

    protected Func<GridState<Structure>, Task<GridData<Structure>>> TableDataLoader { get; private set; } = default!;

    protected Func<GridState<Structure>, Task<IEnumerable<ApplicationUser>>> FilterManagersLoader { get; private set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _items = await LoadServerData(null);

        TableDataLoader = StructureManager.LoadTableDataFor(User, SelectStructureListData);

        FilterManagersLoader = state => StructureManager.Query<ApplicationUser>(StructureManager.MakeQueryParametersFor(User, SelectFilterManagers)(state));
    }

    private async Task<IEnumerable<ApplicationUser>> SearchManager(string? searchText, CancellationToken cancellationToken)
    {
        var users = await UserRepository.Query(new QueryParameters<ApplicationUser, ApplicationUser>(
                Filter: q => q.Where(u => u.Id != ApplicationUser.RootId),
                Select: (q, _) => q.Select(static u => new ApplicationUser { Id = u.Id, UserName = u.UserName, Email = u.Email }),
                SortAndPaginate: q => q.OrderBy(static u => u.UserName).Take(10),
                User: User
            ), cancellationToken);

        return users.Any(u => u.UserName == searchText) ? users
            : users.Where(u => $"{u.UserName} <{u.Email}>"
                .Contains(searchText ?? string.Empty, StringComparison.CurrentCultureIgnoreCase));
    }

    private async Task<IEnumerable<StructureType>> SearchStructureType(string? searchText, CancellationToken cancellationToken) =>
        await StructureTypeRepository.Query(new QueryParameters<StructureType, StructureType>(
                Filter: q => q.Where(st => searchText == null || q.Any(st => st.Name == searchText) || st.Name.Contains(searchText)),
                Select: (q, _) => q,
                SortAndPaginate: q => q.OrderBy(static st => st.Name).Take(10),
                User: User
            ), cancellationToken);

    private Task SaveStructure(bool updateManager) => Task.WhenAll(
        updateManager ? StructureManager.SetManagerAsync(_selectedStructure!.Id, _selectedStructure!.Manager?.Id) : Task.CompletedTask,
        StructureManager.SetStructureTypeAsync(_selectedStructure!.Id, _selectedStructure!.StructureType.Id));
}
