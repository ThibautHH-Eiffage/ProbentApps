@page "/structures"

@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using ProbentApps.Services.Data.Abstractions.Querying

@inject IStringLocalizer<SharedResources> SharedLocalizer
@inject IUserRepository UserRepository
@inject IRepository<StructureType> StructureTypeRepository
@inject IStructureManager StructureManager
@inject UserManager<ApplicationUser> UserManager

@inherits AuthenticatedPage

<PageTitle Title=@SharedLocalizer["Structures"] />

@* Treeview des structures *@
<StructureTree Items="_items"
    SelectedStructure=_selectedStructure SelectedStructureChanged="OnSelectedStructureChanged"
    ManagerFinder="SearchManager" StructureTypeFinder="SearchStructureType"
    TreeItemDataLoader="LoadServerData" OnSave="SaveStructure"
    ExtraManagers="_extraStructureManagers"
    OnAddExtraManager="AddExtraManager" OnRemoveExtraManager="RemoveExtraManager" />

@code {
    private IReadOnlyCollection<TreeItemData<Structure>> _items = default!;
    private Structure? _selectedStructure;
    private List<ApplicationUser> _extraStructureManagers = [];

    public async Task<IReadOnlyCollection<TreeItemData<Structure>>> LoadServerData(Structure? parentValue)
    {
        return (IReadOnlyCollection<TreeItemData<Structure>>) await StructureManager.Query<TreeItemData<Structure>>(new QueryParameters<Structure, TreeItemData<Structure>>(
            Filter: q => q.Where(parentValue?.Code is string code
                ? s => s.Code.StartsWith(code + "|") && !(s.Code.Substring(code.Length + 1).Contains("|"))
                : s => !q.Any(structure => s.Code.StartsWith(structure.Code + '|'))),
            Select: (q, r) =>
            {
                var structures = r.GetEntitySet<Structure>();
                return q.Select(s => new TreeItemData<Structure>
                {
                    Value = new Structure
                    {
                        Id = s.Id,
                        Name = s.Name,
                        Code = s.Code,
                        Manager = s.Manager == null ? null : new ApplicationUser
                        {
                            Id = s.Manager.Id,
                            UserName = s.Manager.UserName,
                            Email = s.Manager.Email
                        },
                        StructureType = new StructureType
                        {
                            Id = s.StructureType.Id,
                            Name = s.StructureType.Name,
                            SvgIconCode = s.StructureType.SvgIconCode
                        }
                    },
                    Expandable = structures.Any(structure => structure.Code.StartsWith(s.Code + "|"))
                });
            },
            SortAndPaginate: q => q,
            User: User,
            ToList: true
        ));
    }

    private static IQueryable<Structure> SelectStructureListData(IQueryable<Structure> query) => query
        .Select(static s => new Structure
        {
            Id = s.Id,
            Name = s.Name,
            Code = s.Code,
            ShortCode = s.ShortCode,
            Manager = s.Manager == null ? null : new ApplicationUser
            {
                Id = s.Manager.Id,
                UserName = s.Manager.UserName,
                Email = s.Manager.Email
            },
            StructureType = s.StructureType
        });

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        _items = await LoadServerData(null);
    }

    private async Task OnSelectedStructureChanged(Structure? structure)
    {
        _selectedStructure = structure;

        _extraStructureManagers = structure is not null
            ? await UserRepository.GetExtraManagersForAsync(structure.Id) : [];
    }

    private async Task<IEnumerable<ApplicationUser>> SearchManager(string? searchText, CancellationToken cancellationToken)
    {
        var users = await UserRepository.Query(new QueryParameters<ApplicationUser, ApplicationUser>(
                Filter: q => q.Where(u => u.Id != ApplicationUser.RootId),
                Select: (q, _) => q.Select(static u => new ApplicationUser { Id = u.Id, UserName = u.UserName, Email = u.Email }),
                SortAndPaginate: q => q.OrderBy(static u => u.UserName).Take(10),
                User: User
            ), cancellationToken);
            // await UserRepository.GetExtraManagersForAsync(_selectedStructure!.Id, true, cancellationToken);

        return users.Any(u => u.UserName == searchText) ? users
            : users.Where(u => $"{u.UserName} <{u.Email}>"
                .Contains(searchText ?? string.Empty, StringComparison.CurrentCultureIgnoreCase));
    }

    private async Task<IEnumerable<StructureType>> SearchStructureType(string? searchText, CancellationToken cancellationToken) =>
        await StructureTypeRepository.Query(new QueryParameters<StructureType, StructureType>(
                Filter: q => q.Where(st => searchText == null || q.Any(st => st.Name == searchText) || st.Name.Contains(searchText)),
                Select: (q, _) => q,
                SortAndPaginate: q => q.OrderBy(static st => st.Name).Take(10),
                User: User
            ), cancellationToken);

    private Task SaveStructure(bool updateManager) => Task.WhenAll(
        updateManager ? StructureManager.SetManagerAsync(_selectedStructure!.Id, _selectedStructure!.Manager?.Id) : Task.CompletedTask,
        StructureManager.SetStructureTypeAsync(_selectedStructure!.Id, _selectedStructure!.StructureType.Id));

    // Traitement des claims pour l'accès au structures
    const string ClaimType = "ExtraManagedStructures";

    private async Task AddExtraManager(ApplicationUser user)
    {
        user = (await UserManager.FindByIdAsync(user.Id.ToString()))!;
        //recherche de la (des) claims relatifs aux "ExtraManagers"
        var claims = (await UserManager.GetClaimsAsync(user)).Where(c => c.Type == ClaimType);
        //liste des Guids ExtraManager
        var extraManagedStructuresIds = claims
            .SelectMany(static c => c.Value
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(Guid.Parse))
            .Distinct();
        // Si l'extramanager est présent => pas d'action
        if (extraManagedStructuresIds.Contains(_selectedStructure!.Id))
            return;

        Claim? replacedClaim = claims.FirstOrDefault();
        if (replacedClaim is not null)
            // s'il exist un Claims "ExtraManager" => ajout du Guid de la structure sélectionnée sous forme de texte dans la chaine
            await UserManager.ReplaceClaimAsync(user, replacedClaim, new Claim(
                type: replacedClaim.Type, value: $"{replacedClaim.Value},{_selectedStructure!.Id}",
                valueType: replacedClaim.ValueType, issuer: replacedClaim.Issuer,
                originalIssuer: replacedClaim.OriginalIssuer, subject: replacedClaim.Subject
            ));
        else
            // Création d'une nouvelle Claim "Extramanager" avec le Guid de l'Application user sélectionnée
            await UserManager.AddClaimAsync(user, new(type: ClaimType, _selectedStructure!.Id.ToString(), null, $"{nameof(ProbentApps)}"));
    }

    private async Task RemoveExtraManager(ApplicationUser user)
    {
        user = (await UserManager.FindByIdAsync(user.Id.ToString()))!;
        //recherche de la (des) claims relatifs aux "ExtraManagers"
        var claims = (await UserManager.GetClaimsAsync(user)).Where(c => c.Type == ClaimType);
        //liste des Guids ExtraManager
        var extraManagedStructuresIds = claims
            .SelectMany(static c => c.Value
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(Guid.Parse))
            .Distinct();
        // Si l'extramanager n'est pas présent => pas d'action
        if (!extraManagedStructuresIds.Contains(_selectedStructure!.Id))
            return;

        if (extraManagedStructuresIds.Count() == 1)
            // s'il n'y a qu'un seul ExtraManager => on peut supprimer la claim
            await UserManager.RemoveClaimAsync(user, claims.First());
        else
        {
            // modification de la chaine de caractère de valeur de la claim en supprimant le Guid de utilisateur
            Claim? replacedClaim = claims.FirstOrDefault();
            string newClaimStringGuid = string.Join("," , extraManagedStructuresIds.Where(g => g != _selectedStructure!.Id));
            await UserManager.ReplaceClaimAsync(user, replacedClaim!, new Claim(
                type: replacedClaim!.Type, value: newClaimStringGuid,
                valueType: replacedClaim.ValueType, issuer: replacedClaim.Issuer,
                originalIssuer: replacedClaim.OriginalIssuer, subject: replacedClaim.Subject
            ));
        }
    }
}
